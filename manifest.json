{
  "manifest_version": 3,
  "name": "Chatbot Side Panel for Dify",
  "version": "2.1.0",
  "description": "Opens a Dify chatbot in Chrome's side panel, beside any page.",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open the Dify chatbot"
  }
}
